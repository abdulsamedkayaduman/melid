<?xml version="1.0" encoding="utf-8"?>
<!-- Varsayılan: şifresiz HTTP kapalı. İstisna: güncelleme sunucusu (ev ağındaki Forgejo, yalnız HTTP).
     İçerik Ed25519 imzalı (Updater.java), APK ayrıca Android'in imza kontrolünden geçer. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.50</domain>
    </domain-config>
</network-security-config>
