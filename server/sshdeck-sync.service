# SSHDeck eşitleme sunucusu — systemd birimi (örnek)
# Kurulum:
#   sudo useradd -r -m -d /var/lib/sshdeck-sync sshdeck-sync
#   sudo cp server/sync-server.js /opt/sshdeck-sync/
#   sudo cp server/sshdeck-sync.service /etc/systemd/system/   (davet kodunu değiştirin)
#   sudo systemctl enable --now sshdeck-sync
[Unit]
Description=SSHDeck eşitleme sunucusu
After=network.target

[Service]
User=sshdeck-sync
Environment=PORT=3150
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/var/lib/sshdeck-sync
Environment=SSHDECK_SYNC_INVITE=buraya-uzun-rastgele-bir-davet-kodu
ExecStart=/usr/bin/node /opt/sshdeck-sync/sync-server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sshdeck-sync
PrivateTmp=true

[Install]
WantedBy=multi-user.target
