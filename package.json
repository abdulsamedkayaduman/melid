{
  "name": "sshdeck",
  "version": "1.8.0",
  "description": "Linux ve Windows için Xshell/Xftp tarzı SSH terminali ve SFTP dosya yöneticisi",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "SSHDECK_DEV=1 electron .",
    "dist": "electron-builder --linux AppImage pacman",
    "dist:appimage": "electron-builder --linux AppImage",
    "test": "bash test/run.sh",
    "dist:win": "electron-builder --win"
  },
  "author": {
    "name": "Abdulsamed Kayaduman",
    "email": "abdulsamedkayaduman@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "productName": "SSHDeck",
  "build": {
    "appId": "dev.sshdeck.app",
    "productName": "SSHDeck",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.mjs",
      "!test/**/*"
    ],
    "linux": {
      "category": "Network;RemoteAccess",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "pacman"
      ],
      "desktop": {
        "entry": {
          "Name": "SSHDeck",
          "Comment": "SSH terminal ve SFTP istemcisi",
          "Keywords": "ssh;sftp;terminal;xshell;xftp;"
        }
      },
      "maintainer": "Abdulsamed Kayaduman <abdulsamedkayaduman@gmail.com>"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libsecret"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SSHDeck",
      "artifactName": "SSHDeck-${version}-kurulum.${ext}",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ]
    },
    "portable": {
      "artifactName": "SSHDeck-${version}-tasinabilir.${ext}"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/ssh2/util/pagent.exe"
    ]
  },
  "homepage": "https://sshdeck.local"
}
